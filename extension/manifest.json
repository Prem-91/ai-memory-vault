{
  "manifest_version": 3,
  "name": "AI Context Bridge",
  "version": "1.1.0",
  "description": "Capture context from any AI chat (ChatGPT, Claude, Gemini, Perplexity, Copilot, Mistral, DeepSeek, Grok, Poe & more) and inject memory packs back.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "contextMenus"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/chat*",
    "https://chat.mistral.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://www.phind.com/*",
    "https://huggingface.co/chat/*",
    "https://*.lovable.app/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_title": "AI Context Bridge"
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/common.js", "content/chatgpt.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/common.js", "content/claude.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/common.js", "content/gemini.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://www.phind.com/*",
        "https://huggingface.co/chat/*"
      ],
      "js": ["content/common.js", "content/generic.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.lovable.app/*", "http://localhost/*"],
      "js": ["content/dashboard-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/styles.css", "icons/icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
