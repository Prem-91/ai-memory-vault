# Required for server-side API/auth flows and SSR usage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for Gemini-powered analysis server function
GEMINI_API_KEY=

# Optional: only required if performing server-side Supabase admin operations
SUPABASE_SERVICE_ROLE_KEY=

# Optional client-side aliases (used by Vite client code if provided)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
